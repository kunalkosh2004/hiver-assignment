# Copy to .env and fill in to enable the (optional) LLM classifier layer.
# The deterministic Phase-4 baselines do NOT require these keys.

# Primary provider (default per spec)
GEMINI_API_KEY=

# Fallback provider
OPENAI_API_KEY=

# Optional overrides, defaulting to sensible values:
# LLM_MODEL=gemini-2.0-flash
# LLM_FALLBACK_MODEL=gpt-4o-mini
# LLM_MAX_CALLS_PER_RUN=200
# LLM_TIMEOUT=30